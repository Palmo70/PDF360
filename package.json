{
  "name": "pdf-viewer",
  "version": "0.1.0",
  "description": "Adobe Acrobat-style PDF viewer built on Node + PDF.js",
  "main": "server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node server.js",
    "dev": "cross-env NODE_ENV=development nodemon --watch server.js --watch public --watch i18n server.js"
  },
  "dependencies": {
    "@azure/msal-node": "^5.1.2",
    "argon2": "^0.44.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "express-slow-down": "^3.1.0",
    "geoip-lite": "^2.0.1",
    "helmet": "^8.1.0",
    "otplib": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4"
